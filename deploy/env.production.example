# crabAI PRODUCTION environment variables.
# Copy to /opt/crabai-api/.env and fill in your real keys.
# Permissions: chmod 600 .env (only the crabai user can read).

# --- LLM (set ONE — first one found wins) ---
# NVIDIA NIM API (recommended, free) — https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-real-key

# Optional: pick a specific NVIDIA model.
# LLM_MODEL=qwen/qwen2.5-7b-instruct   # best for bilingual EN/中文
# LLM_MODEL=meta/llama-3.3-70b-instruct  # default, best for RAG

# OR Groq (free, very fast) — used only if NVIDIA_API_KEY is empty
# GROQ_API_KEY=gsk-your-real-key

# --- Embeddings (set ONE — first one found wins) ---
# Cloudflare Workers AI (matches the reference stack)
CF_API_TOKEN=your-cloudflare-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id

# OR Nomic hosted API (free 1M tokens/month)
# NOMIC_API_KEY=your-nomic-key

# --- Production FastAPI tuning ---
# Bind to localhost only — nginx proxies from outside.
# (We set --host 127.0.0.1 on the uvicorn command line, not here, but you can
#  override RAG_PRELOAD_PDF to preload a default PDF at startup.)
# RAG_PRELOAD_PDF=/opt/crabai-api/data/seed_docs/company_handbook.pdf
